FROM composer:2 AS vendor

WORKDIR /var/www/html

COPY composer.json composer.lock ./

# Install dependency packages first so this layer can be reused when only app source changes.
RUN composer install \
    --no-dev \
    --prefer-dist \
    --no-interaction \
    --no-progress \
    --no-scripts \
    --no-autoloader

COPY app ./app
COPY bootstrap ./bootstrap
COPY config ./config
COPY database ./database
COPY public ./public
COPY resources ./resources
COPY routes ./routes
COPY artisan ./artisan

# Generate optimized autoloader and run post-autoload-dump scripts (e.g. artisan package:discover).
RUN composer dump-autoload --optimize

FROM php:8.4-fpm-alpine

ARG WWWUSER=1000
ARG WWWGROUP=1000

RUN apk add --no-cache \
    icu-dev \
    libzip-dev \
    oniguruma-dev \
    postgresql-dev \
    bash \
    && docker-php-ext-install \
        bcmath \
        intl \
        mbstring \
        pdo \
        pdo_pgsql \
        zip

RUN addgroup -S -g ${WWWGROUP} appgroup \
    && adduser -S -D -u ${WWWUSER} -G appgroup -h /home/app app \
    && mkdir -p /home/app

WORKDIR /var/www/html

COPY --from=vendor --chown=${WWWUSER}:${WWWGROUP} /var/www/html /var/www/html

RUN mkdir -p \
    storage/framework/cache \
    storage/framework/sessions \
    storage/framework/testing \
    storage/framework/views \
    storage/logs \
    bootstrap/cache \
    && chown -R ${WWWUSER}:${WWWGROUP} /var/www/html/storage /var/www/html/bootstrap/cache /home/app

ENV HOME=/home/app

USER app

EXPOSE 9000
